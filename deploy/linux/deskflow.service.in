[Unit]
Description=Deskflow user session service
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/deskflow

[Install]
WantedBy=default.target
